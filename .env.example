# Server-side secrets for the generation proxy (Next.js API route / serverless fn).
# Copy to .env.local and fill in. These NEVER reach the browser (no NEXT_PUBLIC_ prefix).

# BE-AI-Wrapper-V2 request signing — provided by BE team.
BE_SIGNATURE_KEY=
BE_KEY_ID=

# Client-safe (can be NEXT_PUBLIC_*): mirrored from config.js for the Next.js port.
NEXT_PUBLIC_BE_BASE=https://api-img-gen-wrapper.apero.vn
NEXT_PUBLIC_BUNDLE_ID=
NEXT_PUBLIC_WORKFLOW_T2I=bfe17c02-1437-43d6-a554-a0451dd8ace4
